
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para obter dados do perfil do usuário logado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário é um administrador
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }

    // Verifica se o usuário é do suporte (incluindo coordenador)
    function isSupportUser() {
      let data = getUserData();
      return request.auth != null && data.role == 'admin' && (data.adminType == 'suporte' || data.adminType == 'coordenador_suporte');
    }

    // Verifica se o usuário é o Coordenador de Suporte
    function isSupportCoordinator() {
      let data = getUserData();
      return request.auth != null && data.role == 'admin' && data.adminType == 'coordenador_suporte';
    }

    match /users/{userId} {
      // Regra de segurança: impede que usuários alterem seu próprio role ou adminType
      // Só permite alteração se os campos protegidos não estiverem sendo modificados por não-admins
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminType', 'status']) || isAdmin());
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSupportUser();

      match /activationFlows/{flowId} {
        allow read: if true;
        allow write: if isSupportUser();

        match /steps/{stepId} {
          allow read: if true;
          allow write: if isSupportUser();
        }
      }
    }

    match /onboardingInstances/{instanceId} {
      allow read, write: if true;
    }

    match /interactions/{interactionId} {
      allow read, write: if true;
    }

    match /system_logs/{logId} {
      allow read, write: if true;
    }

    // Proteção futura para o módulo de escalas (Sobreaviso)
    match /oncall_scales/{scaleId} {
      allow read: if isSupportUser();
      allow write: if isSupportCoordinator();
    }
  }
}
