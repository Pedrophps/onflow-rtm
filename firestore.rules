
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSupportAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminType == 'suporte';
    }

    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isSupportAdmin();

      match /activationFlows/{flowId} {
        allow read: if request.auth != null;
        allow write: if isSupportAdmin();

        match /steps/{stepId} {
          allow read: if request.auth != null;
          allow write: if isSupportAdmin();
        }
      }
    }

    match /onboardingInstances/{instanceId} {
      allow read: if request.auth != null && (resource.data.clientId == request.auth.uid || isAdmin());
      allow write: if isSupportAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /onboardingFlows/{flowId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
