
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para obter dados do perfil do usuário logado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário é um administrador
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }

    // Verifica se o usuário é do suporte
    function isSupportAdmin() {
      let data = getUserData();
      return request.auth != null && data.role == 'admin' && data.adminType == 'suporte';
    }

    match /users/{userId} {
      // Permite que a API busque (list/get) e crie/atualize (create/update) usuários
      // Necessário para o fluxo de ingestão automática via ERP/Workstation
      allow list, get, create, update: if true; 
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      // Leitura pública permitida para que a API mapeie nomes de produtos em IDs reais
      allow read: if true;
      allow write: if isSupportAdmin();

      match /activationFlows/{flowId} {
        allow read: if true;
        allow write: if isSupportAdmin();

        match /steps/{stepId} {
          allow read: if true;
          allow write: if isSupportAdmin();
        }
      }
    }

    match /onboardingInstances/{instanceId} {
      // Permite que a API crie novas instâncias de onboarding
      allow create: if true;
      // Leitura permitida para o dono do projeto ou admins
      allow read: if request.auth != null && (resource.data.clientId == request.auth.uid || isAdmin());
      // Atualização de status e vínculo técnico restrito a admins
      allow update, delete: if isAdmin();
    }

    match /interactions/{interactionId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.clientId == request.auth.uid);
    }

    match /system_logs/{logId} {
      // Permite que o sistema registre logs técnicos de qualquer origem (API e Auditoria)
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /onboardingFlows/{flowId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
