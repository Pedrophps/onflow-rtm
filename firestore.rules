
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para obter dados do perfil do usuário logado de forma segura
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    // Verifica se o usuário é um Administrador (Suporte ou Comercial)
    function isAdmin() {
      let data = getUserData();
      return request.auth != null && data != null && data.role == 'admin';
    }

    // Verifica se o usuário é especificamente do Suporte Técnico
    function isSupportAdmin() {
      let data = getUserData();
      return request.auth != null && data != null && data.adminType == 'suporte';
    }

    match /users/{userId} {
      // Admins podem listar e ler qualquer usuário. Clientes leem apenas seu próprio perfil.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Admins podem atualizar perfis (para aprovação/configuração). Clientes editam apenas a si mesmos.
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isSupportAdmin();

      match /activationFlows/{flowId} {
        allow read: if request.auth != null;
        allow write: if isSupportAdmin();

        match /steps/{stepId} {
          allow read: if request.auth != null;
          allow write: if isSupportAdmin();
        }
      }
    }

    match /onboardingInstances/{instanceId} {
      // Listagem: Administradores podem listar tudo. Clientes apenas o que lhes pertence.
      allow list: if request.auth != null && (isAdmin() || (resource != null && resource.data.clientId == request.auth.uid));
      // Get: Permite leitura individual para o dono ou admins.
      allow get: if request.auth != null && (isAdmin() || (resource != null && resource.data.clientId == request.auth.uid));
      // Escrita: Administradores gerenciam a operação técnica.
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow list: if request.auth != null && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow get: if request.auth != null && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
    }

    match /interactions/{interactionId} {
      // Admins leem tudo. Clientes apenas o que lhes pertence. 
      // Para consultas (list), o filtro clientId deve estar presente na query.
      allow read: if request.auth != null && (isAdmin() || (resource != null && resource.data.clientId == request.auth.uid));
      // Criação permitida para qualquer usuário autenticado
      allow create: if request.auth != null;
    }

    // Regra legado para compatibilidade de testes
    match /onboardingFlows/{flowId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
