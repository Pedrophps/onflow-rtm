
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para obter dados do perfil do usuário logado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário é um administrador
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }

    // Verifica se o usuário é do suporte
    function isSupportAdmin() {
      let data = getUserData();
      return request.auth != null && data.role == 'admin' && data.adminType == 'suporte';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isSupportAdmin();

      match /activationFlows/{flowId} {
        allow read: if request.auth != null;
        allow write: if isSupportAdmin();

        match /steps/{stepId} {
          allow read: if request.auth != null;
          allow write: if isSupportAdmin();
        }
      }
    }

    match /onboardingInstances/{instanceId} {
      allow read: if request.auth != null && (resource.data.clientId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /interactions/{interactionId} {
      // Regra de Leitura (Get e List)
      // Administradores podem ler tudo; Clientes apenas o que lhes pertence.
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.clientId == request.auth.uid
      );
      
      // Regra de Criação
      allow create: if request.auth != null && (
        isAdmin() || 
        request.resource.data.clientId == request.auth.uid
      );
    }

    match /system_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /submissions/{submissionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /onboardingFlows/{flowId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
