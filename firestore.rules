
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar otimizada para obter dados do perfil
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário tem papel de admin
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }

    // Verifica se o usuário é especificamente do Suporte Técnico
    function isSupportAdmin() {
      let data = getUserData();
      return request.auth != null && data.role == 'admin' && data.adminType == 'suporte';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isSupportAdmin();

      match /activationFlows/{flowId} {
        allow read: if request.auth != null;
        allow write: if isSupportAdmin();

        match /steps/{stepId} {
          allow read: if request.auth != null;
          allow write: if isSupportAdmin();
        }
      }
    }

    match /onboardingInstances/{instanceId} {
      allow list: if request.auth != null && (resource.data.clientId == request.auth.uid || isAdmin());
      allow get: if request.auth != null && (resource.data.clientId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /interactions/{interactionId} {
      // Prioriza a verificação de propriedade para evitar chamadas get() desnecessárias para clientes
      allow read: if request.auth != null && (
        resource.data.clientId == request.auth.uid || 
        isAdmin()
      );
      // Garante que o cliente só crie interações para si mesmo
      allow create: if request.auth != null && (
        request.resource.data.clientId == request.auth.uid || 
        isAdmin()
      );
    }

    match /submissions/{submissionId} {
      allow list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /onboardingFlows/{flowId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
