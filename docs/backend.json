
{
  "entities": {
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Dados mestre do usuário, incluindo papéis administrativos (RTM) ou institucionais (Clientes).",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "client"], "description": "Define o acesso básico ao portal." },
        "adminType": { "type": "string", "enum": ["suporte", "comercial"], "description": "Define a visão do dashboard para administradores RTM." },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Status de conformidade do cliente." },
        "displayName": { "type": "string" },
        "institutionName": { "type": "string", "description": "Nome da instituição financeira." },
        "cnpj": { "type": "string" },
        "clientCode": { "type": "string", "description": "Identificador único RTM (Ex: RTM-BR-001)." },
        "activeProduct": { "type": "string", "description": "Produto principal em implantação." },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "approvedAt": { "type": "string" }
      },
      "required": ["email", "role", "displayName", "status"]
    },
    "OnboardingFlow": {
      "title": "Fluxo de Onboarding",
      "description": "Template de sequência de etapas para um produto ou perfil de cliente.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" },
        "productType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "productType"]
    },
    "Stage": {
      "title": "Etapa do Fluxo",
      "description": "Definição de uma fase específica dentro de um fluxo.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "type": { "type": "string", "enum": ["info", "upload", "form"] },
        "required": { "type": "boolean" }
      },
      "required": ["title", "order", "type"]
    },
    "Submission": {
      "title": "Submissão de Evidência",
      "description": "Registro de envio de documentos ou dados por parte do cliente.",
      "type": "object",
      "properties": {
        "stageId": { "type": "string" },
        "userId": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string" },
        "feedback": { "type": "string" }
      },
      "required": ["stageId", "userId", "submittedAt"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Repositório central de identidades e progresso institucional."
    },
    "/onboardingFlows/{flowId}": {
      "schema": { "$ref": "#/backend/entities/OnboardingFlow" },
      "description": "Templates globais de jornadas de onboarding."
    },
    "/onboardingFlows/{flowId}/stages/{stageId}": {
      "schema": { "$ref": "#/backend/entities/Stage" },
      "description": "Etapas configuradas para um fluxo específico."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/backend/entities/Submission" },
      "description": "Coleção centralizada de evidências para análise do Suporte/Comercial."
    }
  }
}
