
{
  "entities": {
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Dados mestre do usuário, incluindo papéis administrativos (RTM) ou institucionais (Clientes).",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "adminType": { "type": "string", "enum": ["suporte", "comercial"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "displayName": { "type": "string" },
        "institutionName": { "type": "string" },
        "cnpj": { "type": "string" },
        "clientCode": { "type": "string" },
        "activeProduct": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "consultantName": { "type": "string", "description": "Nome do consultor RTM responsável pela conta." },
        "orderValue": { "type": "string", "description": "Número da Ordem de Venda (OV) ou identificador do contrato." },
        "commercialNotes": { "type": "string", "description": "Notas ou observações inseridas pelo comercial durante a ativação." },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role", "displayName", "status"]
    },
    "Product": {
      "title": "Produto RTM",
      "description": "Catálogo de serviços financeiros disponíveis para onboarding.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      }
    },
    "OnboardingInstance": {
      "title": "Instância de Onboarding",
      "description": "Execução real de um fluxo de ativação para um cliente específico.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "productId": { "type": "string" },
        "flowId": { "type": "string" },
        "techId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "completed", "blocked"] },
        "currentStepOrder": { "type": "number" },
        "startedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "SystemLog": {
      "title": "Log do Sistema",
      "description": "Registros de eventos técnicos, auditoria de QA e diagnósticos de rede.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "error", "warning"] },
        "userId": { "type": "string" },
        "context": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" }
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" }
    },
    "/products/{productId}/activationFlows/{flowId}": {
      "description": "Subcoleção de fluxos de ativação para um produto específico."
    },
    "/onboardingInstances/{instanceId}": {
      "schema": { "$ref": "#/backend/entities/OnboardingInstance" }
    },
    "/system_logs/{logId}": {
      "schema": { "$ref": "#/backend/entities/SystemLog" }
    }
  }
}
