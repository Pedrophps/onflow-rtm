
{
  "entities": {
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Dados mestres de autenticação e informações institucionais (CNPJ, OV, Consultor).",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "adminType": { "type": "string", "enum": ["suporte", "comercial", "coordenador_suporte"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "displayName": { "type": "string" },
        "institutionName": { "type": "string" },
        "cnpj": { "type": "string" },
        "activeProduct": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "consultantName": { "type": "string" },
        "orderValue": { "type": "string" },
        "commercialNotes": { "type": "string" },
        "approvedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role", "displayName", "status"]
    },
    "OnCallSchedule": {
      "title": "Escala de Sobreaviso",
      "description": "Período programado de disponibilidade de um técnico.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startAt": { "type": "string" },
        "endAt": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "active", "cancelled"] },
        "observations": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "OnCallCheckin": {
      "title": "Check-in de Sobreaviso",
      "description": "Confirmação de disponibilidade do colaborador.",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string" },
        "userId": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "pending"] }
      }
    },
    "OnCallNotification": {
      "title": "Acionamento Operacional",
      "description": "Registro de chamado crítico para técnico em sobreaviso.",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string" },
        "userId": { "type": "string" },
        "requestedBy": { "type": "string" },
        "reason": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "received", "started", "finished"] },
        "sentAt": { "type": "string" },
        "receivedAt": { "type": "string" },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" }
    },
    "/onCallSchedules/{scheduleId}": {
      "schema": { "$ref": "#/backend/entities/OnCallSchedule" }
    },
    "/onCallCheckins/{checkinId}": {
      "schema": { "$ref": "#/backend/entities/OnCallCheckin" }
    },
    "/onCallNotifications/{notificationId}": {
      "schema": { "$ref": "#/backend/entities/OnCallNotification" }
    },
    "/system_logs/{logId}": {
      "schema": { "$ref": "#/backend/entities/SystemLog" }
    }
  }
}
