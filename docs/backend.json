{
  "entities": {
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Informações do usuário incluindo papel (admin/client) e dados institucionais.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "adminType": { "type": "string", "enum": ["suporte", "comercial"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "displayName": { "type": "string" },
        "institutionName": { "type": "string" },
        "cnpj": { "type": "string" },
        "clientCode": { "type": "string" },
        "activeProduct": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role", "displayName", "status"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dados de perfil do usuário indexados pelo UID."
    }
  }
}
