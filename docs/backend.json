
{
  "entities": {
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Informações estendidas do usuário, incluindo seu papel no sistema, CNPJ e status de aprovação.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "E-mail do usuário"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "client"],
          "description": "Papel do usuário no sistema"
        },
        "adminType": {
          "type": "string",
          "enum": ["suporte", "comercial"],
          "description": "Sub-perfil administrativo (selecionado uma única vez)"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Status de aprovação do cliente pelo comercial"
        },
        "displayName": {
          "type": "string",
          "description": "Nome de exibição ou do colaborador"
        },
        "cnpj": {
          "type": "string",
          "description": "CNPJ da empresa vinculada ao usuário"
        },
        "clientCode": {
          "type": "string",
          "description": "Código identificador do cliente atribuído pelo comercial"
        },
        "activeProduct": {
          "type": "string",
          "description": "Produto ativado para o cliente"
        }
      },
      "required": ["email", "role", "displayName", "status"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dados de perfil do usuário indexados pelo UID do Firebase Auth"
    }
  }
}
